# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — the documented template is committed, real values never are
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Types generated from physio-api's openapi.json ARE committed. They are a
# contract artifact, not a build output: the spec lives in a sibling repo that
# CI never checks out, so nothing here could regenerate them. Committing keeps
# contract changes visible in review, and CI diffs them against the published
# spec so a stale copy fails the build.
