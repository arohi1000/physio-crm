# Copy to `.env.local` and adjust. Never commit `.env.local`.
# Everything prefixed NEXT_PUBLIC_ is inlined into the browser bundle, so no
# secret may ever be given that prefix.

# Base URL of physio-api, with no trailing slash.
# Local development: the API listens on 4000, this app on 3002.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Set to `enabled` to route API calls through Mock Service Worker instead of the
# real API. Any other value (or unset) talks to NEXT_PUBLIC_API_BASE_URL.
# Development only — never set this in a deployed environment.
NEXT_PUBLIC_API_MOCKING=disabled

# Absolute or repo-relative path to the API's OpenAPI document, read by
# `npm run generate:api-types`. Defaults to ../physio-api/openapi.json.
# OPENAPI_SPEC_PATH=../physio-api/openapi.json
